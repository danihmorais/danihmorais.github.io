[Unit]
Description=Biblioteca Municipal Carlos Eduardo Telles - API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/daniel/BIBLIOTECA-MUNICIPAL/backend
Environment=BIBLIOTECA_DATA_DIR=/home/daniel/BIBLIOTECA-MUNICIPAL/data
Environment=CORS_ORIGINS=https://danihmorais.github.io
ExecStart=/home/daniel/BIBLIOTECA-MUNICIPAL/backend/.venv/bin/python /home/daniel/BIBLIOTECA-MUNICIPAL/backend/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
